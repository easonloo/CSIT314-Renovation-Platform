  "additional_features": [
    {
      "id": "delete_user_account",
      "role": "User Admin",
      "feature": "Delete another user account",
      "boundary": "accounts.views.account_delete",
      "control": "accounts.controllers.DeleteUserAccountController",
      "method": "delete_account",
      "entity_operations": [
        "accounts.models.UserAccount.delete_account"
      ],
      "route": "account_delete",
      "rules": [
        "Only an active User Admin may confirm deletion.",
        "The acting administrator cannot delete their own account.",
        "A CSRF-protected POST deletes the linked login and cascading records.",
        "Surviving shortlist counters are adjusted atomically."
      ],
      "confirmation_template": "accounts/account_confirm_delete.html",
      "confirmation_method": "GET",
      "deletion_method": "POST"
    },
    {
      "id": "delete_user_profile",
      "role": "User Admin",
      "feature": "Delete an unused user profile",
      "boundary": "accounts.views.profile_delete",
      "control": "accounts.controllers.DeleteUserProfileController",
      "method": "delete_profile",
      "entity_operations": [
        "accounts.models.UserProfile.assigned_account_count",
        "accounts.models.UserProfile.delete_profile"
      ],
      "route": "profile_delete",
      "rules": [
        "Only an active User Admin may confirm deletion.",
        "Assigned profiles are protected until accounts are reassigned or deleted.",
        "A CSRF-protected POST deletes an unused profile."
      ],
      "confirmation_template": "accounts/profile_confirm_delete.html",
      "confirmation_method": "GET",
      "deletion_method": "POST"
    },
    {
      "id": "delete_project_review",
      "role": "Customer",
      "feature": "Delete an owned project review",
      "boundary": "reviews.views.review_delete",
      "control": "reviews.controllers.DeleteProjectReviewController",
      "method": "delete_review",
      "entity_operations": [
        "reviews.models.ProjectReview.find_owned",
        "reviews.models.ProjectReview.delete_review"
      ],
      "route": "review_delete",
      "confirmation_template": "reviews/review_confirm_delete.html",
      "confirmation_method": "GET",
      "deletion_method": "POST",
      "rules": [
        "An active Customer may delete only their own review.",
        "GET displays confirmation and a CSRF-protected POST deletes the review.",
        "The project and other reviews remain intact."
      ]
    }
