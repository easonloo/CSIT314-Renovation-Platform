{
  "schema_version": 1,
  "pattern": "HTTP Boundary -> named user-story Control -> Entity operation -> Django ORM -> database",
  "scope": "The 48 application user stories. Django framework internals and administrative demo-data/image/setup utilities have separate infrastructure responsibilities.",
  "notes": [
    "Each story has a distinct named control; shared routes dispatch by user role, project status, favourite context or report period.",
    "Entity operations include model class methods, instance methods and model managers; the existing database schema is preserved.",
    "A control reference in a dispatcher documents route wiring; behavioural correctness is verified by the application regression tests.",
    "This mapping records the implemented structure and does not substitute for the tutor reviewing the UML and final design."
  ],
  "stories": [
    {
      "id": 1,
      "role": "User Admin",
      "story": "Log in",
      "boundary": "accounts.forms.AccountLoginForm.confirm_login_allowed",
      "control": "accounts.controllers.UserAdminLoginController",
      "method": "can_login",
      "entity_operations": [
        "accounts.models.UserAccount.authenticate_credentials",
        "accounts.models.UserAccount.has_profile_access"
      ],
      "dispatchers": [
        "accounts.controllers.LoginController"
      ],
      "route": "login"
    },
